# Data is never committed; manifests in reports/tables record what exists.
data/raw/*
data/interim/*
data/processed/*
!data/**/.gitkeep

# Secrets
.env

# Environment / tooling
.venv/
__pycache__/
*.pyc
.pytest_cache/
.ipynb_checkpoints/

# Run logs (the run summary CSV in reports/ is committed)
logs/*
!logs/.gitkeep

# Original LaTeX template from the guide (kept locally, not committed)
thesis_template_src/
# LaTeX build files
thesis/*.aux
thesis/*.log
thesis/*.out
thesis/*.toc
thesis/*.lof
thesis/*.lot
thesis/*.bbl
thesis/*.blg
thesis/*.synctex.gz
thesis_overleaf.zip
thesis/report.pdf
thesis_draft.pdf
